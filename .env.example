# Copy to .env (never commit .env).
# If SESSION_SECRET is left unset, the app auto-generates one on first run and
# stores it in the app's user-data folder (see server/config/secrets.js).

# Express session encryption key — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Local server (bound to loopback only)
PORT=3000
HOST=127.0.0.1

NODE_ENV=development
