{
  "name": "data-entry-app",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop data-entry app (Electron shell + Express/EJS server + SQLite)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.js",
    "dev": "node --watch server/index.js",
    "check:security": "node scripts/check-security.js",
    "rebuild": "npx @electron/rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "migrate:make": "knex --knexfile server/db/knexfile.js migrate:make",
    "migrate:latest": "knex --knexfile server/db/knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile server/db/knexfile.js migrate:rollback",
    "migrate:status": "knex --knexfile server/db/knexfile.js migrate:list"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "knex": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^33.0.0"
  }
}
