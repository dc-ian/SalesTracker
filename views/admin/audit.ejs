<%- include('../partials/header', { title }) %>
<h1>Audit log</h1>
<form method="get" action="/admin/audit" class="inline-form">
  <label>Action starts with <input name="action" value="<%= filter %>" placeholder="e.g. order. or user."></label>
  <button class="btn small">Filter</button>
  <% if (filter) { %><a href="/admin/audit">Clear</a><% } %>
</form>
<p class="muted"><%= total %> entr<%= total === 1 ? 'y' : 'ies' %> · append-only: entries cannot be edited or deleted.</p>

<table>
  <thead><tr><th>#</th><th>When (UTC)</th><th>Who</th><th>Action</th><th>Target</th><th>Details</th></tr></thead>
  <tbody>
    <% rows.forEach(function (r) { %>
      <tr>
        <td><%= r.id %></td>
        <td><%= r.created_at %></td>
        <td><%= r.username || '—' %></td>
        <td><code><%= r.action %></code></td>
        <td><%= r.entity_type %><%= r.entity_id ? ' #' + r.entity_id : '' %></td>
        <td><% if (r.details) { %><details><summary>view</summary><pre><%= JSON.stringify(JSON.parse(r.details), null, 2) %></pre></details><% } %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<div class="pager">
  <% if (page > 1) { %><a class="btn small" href="/admin/audit?page=<%= page - 1 %>&action=<%= encodeURIComponent(filter) %>">‹ Newer</a><% } %>
  <span>Page <%= page %> of <%= pages %></span>
  <% if (page < pages) { %><a class="btn small" href="/admin/audit?page=<%= page + 1 %>&action=<%= encodeURIComponent(filter) %>">Older ›</a><% } %>
</div>
<%- include('../partials/footer') %>
