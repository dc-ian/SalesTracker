<%
  const u = locals.user || null;
  const canDo = locals.can || (() => false);
  const messages = locals.flash || [];
%><!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Data Entry</title>
  <link rel="stylesheet" href="/css/app.css">
  <script src="/js/common.js" defer></script>
</head>
<body>
<% if (u) { %>
<nav class="nav">
  <a class="brand" href="/">Sales Tracker</a>
  <a href="/">Stores</a>
  <% if (canDo('MANAGE_PRODUCTS_STORES_USERS')) { %>
    <a href="/admin/stores">Store list</a>
    <a href="/admin/users">Users</a>
  <% } %>
  <span class="spacer"></span>
  <span class="who"><%= u.display_name %> (<%= u.role %>)</span>
  <form method="post" action="/logout" class="inline">
    <%- include('csrf') %>
    <button class="btn small" type="submit">Log out</button>
  </form>
</nav>
<% } %>
<main>
<% messages.forEach(function (f) { %>
  <div class="alert <%= f.type %>"><%= f.msg %></div>
<% }) %>
