<%- include('partials/header', { title }) %>
<h1>Totals</h1>
<div class="toolbar">
  <%- include('partials/monthbar', { base: '/totals', month, prev, next, extra: storeId ? '&store=' + storeId : '', hidden: storeId ? { store: storeId } : {} }) %>
  <form method="get" action="/totals" class="inline-form">
    <input type="hidden" name="month" value="<%= month %>">
    <select name="store" data-autosubmit>
      <option value="">All stores</option>
      <% stores.forEach(function (s) { %><option value="<%= s.id %>" <%= storeId === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %>
    </select>
  </form>
</div>

<div class="alert info">Totals include <strong>approved orders only</strong>.
  <% if (pendingCount > 0) { %><%= pendingCount %> order<%= pendingCount === 1 ? ' is' : 's are' %> still waiting for approval and not counted.<% } %></div>

<div class="stats">
  <div><span class="muted">Total value</span><strong><%= money(grandTotal) %></strong></div>
  <div><span class="muted">Orders</span><strong><%= grandOrders %></strong></div>
  <div><span class="muted">Units</span><strong><%= grandUnits %></strong></div>
</div>

<h2>By store</h2>
<% if (byStore.length === 0) { %><p class="muted">No approved orders in this period.</p><% } else { %>
<table>
  <thead><tr><th>Store</th><th class="num">Orders</th><th class="num">Units</th><th class="num">Total</th></tr></thead>
  <tbody>
    <% byStore.forEach(function (r) { %>
      <tr><td><%= r.name %></td><td class="num"><%= r.orders %></td><td class="num"><%= r.units %></td><td class="num"><%= money(r.total_cents) %></td></tr>
    <% }) %>
  </tbody>
  <tfoot><tr><td><strong>All</strong></td><td class="num"><%= grandOrders %></td><td class="num"><%= grandUnits %></td><td class="num"><strong><%= money(grandTotal) %></strong></td></tr></tfoot>
</table>

<h2>By product</h2>
<table>
  <thead><tr><th>SKU</th><th>Product</th><th class="num">Units</th><th class="num">Total</th></tr></thead>
  <tbody>
    <% byProduct.forEach(function (r) { %>
      <tr><td><%= r.sku %></td><td><%= r.name %></td><td class="num"><%= r.units %></td><td class="num"><%= money(r.total_cents) %></td></tr>
    <% }) %>
  </tbody>
</table>
<% } %>
<%- include('partials/footer') %>
